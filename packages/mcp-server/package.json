{
  "name": "@automatalabs/mcp-server",
  "version": "2.0.1",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentprism/agentprism-workflows.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "agentprism-workflow": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "agentprism-workflow": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/ensure-run-monitor-html.mjs && tsc -b",
    "build:ui": "node ../../scripts/ensure-run-monitor-html.mjs --force",
    "typecheck": "node ../../scripts/ensure-run-monitor-html.mjs && tsc --noEmit && tsc -p ui --noEmit",
    "test": "node ../../scripts/ensure-run-monitor-html.mjs && tsc -p tsconfig.type-tests.json && tsx --test \"test/**/*.test.ts\"",
    "prepublishOnly": "node ../../scripts/ensure-run-monitor-html.mjs && tsc -b"
  },
  "dependencies": {
    "@automatalabs/repl-engine": "workspace:*",
    "@automatalabs/shared-types": "workspace:*",
    "@automatalabs/workflows": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "acorn": "^8.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
