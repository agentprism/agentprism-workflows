    "main": "./dist/lib.js",
    "types": "./dist/lib.d.ts",
    "bin": {
      "pi-acp": "./dist/index.js"
    },
    "exports": {
      ".": {
        "types": "./dist/lib.d.ts",
        "import": "./dist/lib.js",
        "default": "./dist/lib.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.type-tests.json && tsx --test \"test/**/*.test.ts\"",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@earendil-works/pi-coding-agent": "0.80.8",
