{
  "name": "@automatalabs/workflows",
  "version": "0.46.8",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentprism/agentprism-workflows.git",
    "directory": "packages/workflows"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "agentprism-workflows": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/ensure-run-monitor-html.mjs && tsc -b && esbuild ../mcp-server/src/entry.ts --bundle --platform=node --format=esm --target=node22 --external:@automatalabs/* --outfile=dist/mcp-server.js && node ../../scripts/check-workflows-bundle-deps.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@automatalabs/repl-engine": "workspace:*",
    "@automatalabs/shared-types": "workspace:*",
    "@automatalabs/workflow-engine": "workspace:*",
    "@automatalabs/acp-agents": "workspace:*",
    "typebox": "1.3.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
