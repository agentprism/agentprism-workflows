#!/usr/bin/env bash
# Pre-push gate, three checks before code leaves this machine. NO BYPASSES — if a check
# fails, do the maintenance it demands (owner policy, 2026-07-16).
#
# 1. Attribution gate (scripts/check-attribution.mjs) over the commits actually being
#    pushed: no agent attribution in the message, AND no agent author/committer identity —
#    GitHub manufactures a co-author trailer out of that identity when the PR is
#    squash-merged, which is how one slipped onto main past the message-only commit-msg
#    hook (#297). Cheap and offline-ish, so it runs first and fails fast. The same gate is
#    a step of the required CI job, where it runs over the PR's base..head — the only
#    enforcement point that sits BEFORE the squash button.
#
# 2. ACP dependency gate (scripts/check-acp-deps.mjs), three sub-checks:
#      a. freshness — the ACP client/agent libraries (@agentclientprotocol/*,
#         @automatalabs/codex-acp, @earendil-works/pi-coding-agent) must be at npm
#         `latest`; policy is to bump them at every release.
#      b. fork git sync — the codex-acp fork's published main must contain its upstream
#         (agentclientprotocol/codex-acp) main. Always checked against a real clone with
#         verified remotes: ~/codex-acp (override AGENTPRISM_CODEX_ACP_DIR) when present,
#         else a managed temp clone the gate creates itself.
#      c. wrapped runtime freshness — adapters must not embed a stale agent runtime
#         (claude-agent-acp wraps claude-agent-sdk).
#    The gate FAILS CLOSED: an unreachable registry or unverifiable clone blocks the push.
#    The same gate also runs in the required CI job (blocks every merge) and in
#    release.yml (blocks publishing) — bypassing it locally only moves the failure there.
#    Triage runbook: CONTRIBUTING.md "When the dependency gate blocks".
#
# 3. LIVE backend e2e (packages/mcp-server/test/live-backend.e2e.test.ts) plus native steering
#    smoke (packages/acp-agents/test/steering.live.e2e.test.ts) against the REAL Claude + Codex +
#    OpenCode + pi agents. CI cannot run these (no agent auth —
#    AGENTPRISM_LIVE_E2E stays unset there), so this hook is the only place the
#    structured-output cruxes get exercised against real backends pre-merge. If a leg
#    fails on auth (e.g. an expired login), re-authenticate and push again — never skip.
set -euo pipefail

# CI pushes (the changesets Version Packages branch) have no agent auth — never gate them
# here; CI enforces the dependency gate itself in the Build & test job and in release.yml.
if [ -n "${CI:-}" ]; then exit 0; fi

cd "$(git rev-parse --show-toplevel)"

# Attribution gate. git feeds "<local ref> <local sha> <remote ref> <remote sha>" per pushed
# ref on stdin; the remote sha it reports is the remote's CURRENT tip, so for an existing
# branch the range is exact and never over-blocks on already-pushed history. For a NEW branch
# (remote sha all-zeros) there is no such anchor: fall back to excluding everything already on
# origin, refreshed first so stale remote-tracking refs don't drag old pre-hook commits into
# the range. A failed fetch is not fatal — it can only make the exclusion set smaller, i.e.
# over-block, which still fails closed.
ZERO_SHA="0000000000000000000000000000000000000000"
push_tips=()
push_bounds=()
scan_all_remotes=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO_SHA" ] && continue # ref deletion — nothing is being pushed
  push_tips+=("$local_sha")
  if [ "${remote_sha:-$ZERO_SHA}" = "$ZERO_SHA" ]; then
    scan_all_remotes=1
  else
    push_bounds+=("^$remote_sha")
  fi
done

if [ ${#push_tips[@]} -gt 0 ]; then
  if [ "$scan_all_remotes" = 1 ]; then
    git fetch --quiet origin 2>/dev/null || true
    push_bounds+=("--not" "--remotes=origin")
  fi
  if ! node scripts/check-attribution.mjs "${push_tips[@]}" ${push_bounds[@]+"${push_bounds[@]}"}; then
    echo "" >&2
    echo "pre-push: attribution check FAILED — push blocked." >&2
    echo "  Rewrite the commits listed above, then push again." >&2
    echo "  There is no bypass: the same gate is a step of the required CI job." >&2
    exit 1
  fi
fi

if ! node scripts/check-acp-deps.mjs; then
  echo "" >&2
  echo "pre-push: ACP dependency check FAILED — push blocked." >&2
  echo "  Follow the fix steps listed above, then commit and push again." >&2
  echo "  There is no bypass: the same gate blocks every merge (CI) and release." >&2
  exit 1
fi

echo "pre-push: building workspace, then LIVE backend + Claude/Codex steering e2e (real agents, real tokens; ~60-120s)..." >&2
pnpm build >/dev/null 2>&1

# The full runner output is tee'd to a log, and on failure the failing-test section is
# re-printed LAST — so the exact assertion + per-leg diagnostics are always the final thing
# on screen (never buried under later output or lost to truncation), and the log survives
# for inspection after the run.
E2E_LOG="$(git rev-parse --git-dir)/pre-push-live-e2e.log"
# timeout: an expired agent login must fail the push loudly, not hang it forever.
if ! AGENTPRISM_LIVE_E2E=1 timeout 420 npx tsx --test packages/mcp-server/test/live-backend.e2e.test.ts packages/acp-agents/test/steering.live.e2e.test.ts 2>&1 | tee "$E2E_LOG" >&2; then
  echo "" >&2
  echo "pre-push: LIVE backend e2e FAILED — push blocked. Exact failure:" >&2
  if grep -q "failing tests:" "$E2E_LOG"; then
    # Re-print from the runner's failing-tests summary to EOF: test name, assertion
    # message, and the diag() dump (status/errors/stderr tail per failing leg).
    sed -n '/failing tests:/,$p' "$E2E_LOG" >&2
  else
    echo "  (runner produced no failing-tests summary — likely killed by the 420s timeout; last 40 lines:)" >&2
    tail -40 "$E2E_LOG" >&2
  fi
  echo "" >&2
  echo "  Full log: $E2E_LOG" >&2
  echo "  Check agent auth (claude / codex / opencode login, ~/.pi/agent/auth.json)." >&2
  echo "  A leg stalling with slow turns usually means an expired OAuth session — re-login and retry." >&2
  exit 1
fi
echo "pre-push: live backend e2e green — pushing." >&2
