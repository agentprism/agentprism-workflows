#!/usr/bin/env bash
# Pre-push gate: run the LIVE backend e2e (packages/mcp-server/test/live-backend.e2e.test.ts)
# against the REAL Claude + Codex agents before code leaves this machine. CI cannot run
# these (no agent auth — AGENTPRISM_LIVE_E2E stays unset there), so this hook is the only
# place the structured-output cruxes get exercised against real backends pre-merge.
#
# Bypass for one push:   git push --no-verify
#                  or:   AGENTPRISM_SKIP_LIVE_E2E=1 git push
set -euo pipefail

# CI pushes (the changesets Version Packages branch) have no agent auth — never gate them.
if [ -n "${CI:-}" ]; then exit 0; fi
if [ -n "${AGENTPRISM_SKIP_LIVE_E2E:-}" ]; then
  echo "pre-push: AGENTPRISM_SKIP_LIVE_E2E set — skipping live backend e2e" >&2
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: building workspace, then LIVE backend e2e (real Claude/Codex, real tokens; ~30-60s)..." >&2
pnpm build >/dev/null 2>&1

# timeout: an expired agent login must fail the push loudly, not hang it forever.
if ! AGENTPRISM_LIVE_E2E=1 timeout 300 npx tsx --test packages/mcp-server/test/live-backend.e2e.test.ts; then
  echo "" >&2
  echo "pre-push: LIVE backend e2e FAILED — push blocked." >&2
  echo "  Check agent auth (claude / codex login) and the failure above." >&2
  echo "  Bypass once: git push --no-verify  (or AGENTPRISM_SKIP_LIVE_E2E=1 git push)" >&2
  exit 1
fi
echo "pre-push: live backend e2e green — pushing." >&2
