#!/usr/bin/env bash
# Pre-push gate, two checks before code leaves this machine:
#
# 1. ACP dependency gate (scripts/check-acp-deps.mjs), two sub-checks:
#      a. freshness — the ACP client/agent libraries (@agentclientprotocol/*,
#         @automatalabs/codex-acp) must be at npm `latest`; policy is to bump them at every
#         release.
#      b. fork git sync — the codex-acp fork's published main must contain its upstream
#         (agentclientprotocol/codex-acp) main. Checked via the local clone's `upstream`
#         remote (~/codex-acp, override AGENTPRISM_CODEX_ACP_DIR) or the GitHub compare API
#         when no clone exists (GITHUB_TOKEN passed from `gh auth token` below).
#    Registry/API unreachable warns and passes (offline never bricks a push).
#    Bypass once: AGENTPRISM_SKIP_ACP_DEP_CHECK=1 git push
#
# 2. LIVE backend e2e (packages/mcp-server/test/live-backend.e2e.test.ts) against the REAL
#    Claude + Codex + OpenCode agents. CI cannot run these (no agent auth — AGENTPRISM_LIVE_E2E
#    stays unset there), so this hook is the only place the structured-output cruxes get
#    exercised against real backends pre-merge.
#    Bypass once: AGENTPRISM_SKIP_LIVE_E2E=1 git push
#
# git push --no-verify skips the whole hook.
set -euo pipefail

# CI pushes (the changesets Version Packages branch) have no agent auth — never gate them.
if [ -n "${CI:-}" ]; then exit 0; fi

cd "$(git rev-parse --show-toplevel)"

if [ -n "${AGENTPRISM_SKIP_ACP_DEP_CHECK:-}" ]; then
  echo "pre-push: AGENTPRISM_SKIP_ACP_DEP_CHECK set — skipping ACP dep check" >&2
elif ! GITHUB_TOKEN="${GITHUB_TOKEN:-$(gh auth token 2>/dev/null || true)}" node scripts/check-acp-deps.mjs; then
  echo "" >&2
  echo "pre-push: ACP dependency check FAILED — push blocked." >&2
  echo "  Follow the fix steps listed above, then commit and push again." >&2
  echo "  Bypass once: AGENTPRISM_SKIP_ACP_DEP_CHECK=1 git push  (or git push --no-verify)" >&2
  exit 1
fi

if [ -n "${AGENTPRISM_SKIP_LIVE_E2E:-}" ]; then
  echo "pre-push: AGENTPRISM_SKIP_LIVE_E2E set — skipping live backend e2e" >&2
  exit 0
fi

echo "pre-push: building workspace, then LIVE backend e2e (real Claude/Codex/OpenCode, real tokens; ~60-120s)..." >&2
pnpm build >/dev/null 2>&1

# timeout: an expired agent login must fail the push loudly, not hang it forever.
if ! AGENTPRISM_LIVE_E2E=1 timeout 420 npx tsx --test packages/mcp-server/test/live-backend.e2e.test.ts; then
  echo "" >&2
  echo "pre-push: LIVE backend e2e FAILED — push blocked." >&2
  echo "  Check agent auth (claude / codex / opencode login) and the failure above." >&2
  echo "  Bypass once: git push --no-verify  (or AGENTPRISM_SKIP_LIVE_E2E=1 git push)" >&2
  exit 1
fi
echo "pre-push: live backend e2e green — pushing." >&2
