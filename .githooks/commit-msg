#!/usr/bin/env bash
# Commit-message gate: REJECT Claude-generated attribution in commit messages. NO BYPASSES
# (owner policy, 2026-07-23). No Claude session links, no Claude co-author trailers, no
# "Generated with Claude Code" banners. Claude: do NOT re-add these, and do NOT amend or
# alter this hook to get a commit through.
set -euo pipefail

MSG_FILE="$1"

PATTERNS=(
  'Claude-Session:'
  'claude\.ai/code'
  'Co-Authored-By:.*[Cc]laude'
  'noreply@anthropic\.com'
  'Generated with.*Claude'
)

for pattern in "${PATTERNS[@]}"; do
  if grep -Eq "$pattern" "$MSG_FILE"; then
    echo "commit-msg hook: REJECTED — commit message contains Claude attribution matching: $pattern" >&2
    echo "Remove the Claude attribution (session link, co-author trailer, banner) and retry." >&2
    exit 1
  fi
done

exit 0
