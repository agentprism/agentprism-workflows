{
  "name": "agentprism-workflows",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "pnpm -r exec tsc -b",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "pnpm build && pnpm -r test",
    "generate:acp-backends-manifest": "tsx scripts/generate-acp-backends-manifest.ts",
    "check:acp-backends-manifest": "tsx scripts/generate-acp-backends-manifest.ts --check",
    "generate:authoring-prompt": "node scripts/generate-authoring-prompt.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
