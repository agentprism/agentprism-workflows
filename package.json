{
  "name": "agentprism-workflows",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "postinstall": "node scripts/ensure-run-monitor-html.mjs --soft",
    "build": "pnpm -r run build",
    "typecheck": "node scripts/ensure-run-monitor-html.mjs && pnpm -r exec tsc --noEmit",
    "test": "pnpm build && pnpm -r --filter '!@automatalabs/codex-acp' test",
    "generate:acp-backends-manifest": "tsx scripts/generate-acp-backends-manifest.ts",
    "check:acp-backends-manifest": "tsx scripts/generate-acp-backends-manifest.ts --check",
    "generate:authoring-prompt": "node scripts/generate-authoring-prompt.mjs",
    "sync:codex-acp": "node scripts/sync-codex-acp.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "@anthropic-ai/claude-agent-sdk": "0.3.238"
    }
  }
}
